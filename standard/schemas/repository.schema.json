{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igmc.local/schemas/repository.schema.json",
  "title": "IGMC Repository Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "standard",
    "paths",
    "commands",
    "skills",
    "automation",
    "integrations",
    "exemptions"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "archetype", "lifecycle", "visibility"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "archetype": {
          "enum": [
            "generic-software",
            "rust-terminal-application",
            "unity-project",
            "web-application",
            "python-tool",
            "documentation-only",
            "javascript-library",
            "research-repository",
            "creative-prototype",
            "client-delivery"
          ]
        },
        "lifecycle": { "enum": ["active", "maintenance", "archived"] },
        "visibility": { "enum": ["private", "internal", "public"] }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "version"],
      "properties": {
        "profile": { "const": "codex-local-first" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": { "type": ["string", "array"] },
      "required": ["documentation", "design", "decisions", "plans", "tickets"]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "validate", "test", "format_check", "lint"],
      "properties": {
        "setup": { "type": ["string", "null"] },
        "validate": { "type": ["string", "null"] },
        "test": { "type": ["string", "null"] },
        "format_check": { "type": ["string", "null"] },
        "lint": { "type": ["string", "null"] }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unattended_ai", "scheduled_ai", "remote_execution", "external_writes", "paid_services"],
      "properties": {
        "unattended_ai": { "const": false },
        "scheduled_ai": { "const": false },
        "remote_execution": { "const": "explicit-only" },
        "external_writes": { "const": "explicit-only" },
        "paid_services": { "const": "explicit-only" }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "mcp"],
      "properties": {
        "github": { "enum": ["disabled", "optional", "enabled"] },
        "mcp": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "reason"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "review_after": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
