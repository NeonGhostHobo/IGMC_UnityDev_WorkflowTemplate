{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igmc.local/schemas/issue.schema.json",
  "title": "IGMC Issue Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "type", "area", "status", "summary", "acceptance_criteria", "validation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["bug", "feature", "maintenance", "documentation", "research"] },
    "area": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "active", "blocked", "done", "archived"] },
    "summary": { "type": "string", "minLength": 1 },
    "motivation": { "type": "string" },
    "scope": { "type": "object" },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "implementation_notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
