{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igmc.local/schemas/migration-manifest.schema.json",
  "title": "IGMC Scaffold Migration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "created_at", "mode", "repository", "standard_version", "components", "operations"],
  "properties": {
    "manifest_version": { "const": "2.0" },
    "created_at": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["plan", "apply"] },
    "state": { "enum": ["completed"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "archetype"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "archetype": { "type": "string", "minLength": 1 }
      }
    },
    "standard_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "github_metadata", "github_ci"],
      "properties": {
        "core": { "const": true },
        "github_metadata": { "type": "boolean" },
        "github_ci": { "type": "boolean" }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "component", "action", "source_sha256", "destination_sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "action": { "enum": ["create", "unchanged", "conflict", "overwrite"] },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "destination_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
